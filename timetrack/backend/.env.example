# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (XAMPP MySQL) ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=timetrack_db

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# ─── PHP Bridge ───────────────────────────────────────────
BRIDGE_URL=http://localhost/timetrack/database_bridge.php
BRIDGE_SECRET_KEY=timetrack_bridge_secret_2024

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
